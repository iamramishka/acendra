{
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/marketplace/:path*"
    },
    {
      "destination": "/index.html",
      "source": "/checkout/:path*"
    },
    {
      "destination": "/index.html",
      "source": "/dashboard/:path*"
    },
    {
      "destination": "/index.html",
      "source": "/learn/:path*"
    },
    {
      "destination": "/index.html",
      "source": "/login"
    },
    {
      "destination": "/index.html",
      "source": "/register"
    },
    {
      "destination": "/index.html",
      "source": "/verify-email"
    },
    {
      "destination": "/index.html",
      "source": "/forgot-password"
    },
    {
      "destination": "/index.html",
      "source": "/reset-password"
    },
    {
      "destination": "/index.html",
      "source": "/profile/:path*"
    },
    {
      "destination": "/index.html",
      "source": "/bank-transfer/:path*"
    },
    {
      "destination": "/index.html",
      "source": "/admin/:path*"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://worrsweluwjmppwsygre.supabase.co wss://worrsweluwjmppwsygre.supabase.co https://www.gstatic.com https://fonts.googleapis.com https://fonts.gstatic.com https://stream.mux.com; media-src 'self' blob: https://stream.mux.com; worker-src 'self' blob:; form-action https://sandbox.payhere.lk"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=()"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "version": 2
}
