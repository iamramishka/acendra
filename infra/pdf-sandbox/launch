#!/bin/sh
# Fixed trusted command. Never receives source bytes, identity or paths as args.
set -eu
test "$#" -eq 1
case "$1" in --check|--generate) ;; *) exit 1 ;; esac
test "$(id -u)" -ne 0
exec /usr/bin/setpriv --no-new-privs /usr/bin/env -i \
  PATH=/opt/acendra/venv/bin:/usr/bin:/bin LANG=C.UTF-8 \
  /usr/bin/bwrap --unshare-all --die-with-parent --new-session --cap-drop ALL \
  --ro-bind /usr /usr --ro-bind /lib /lib --ro-bind /lib64 /lib64 \
  --ro-bind /opt/acendra /opt/acendra \
  --ro-bind /vercel/sandbox/pdf-job/input /input \
  --bind /vercel/sandbox/pdf-job/output /output \
  --proc /proc --dev /dev --tmpfs /tmp --dir /work --chdir /work \
  /opt/acendra/venv/bin/python -I /opt/acendra/sandbox_job.py "$1" \
  >/dev/null 2>/dev/null
