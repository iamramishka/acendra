{
  "name": "acendra-local-tooling",
  "private": true,
  "description": "Pinned Supabase development tools; not Flutter application dependencies",
  "engines": { "node": ">=20" },
  "scripts": {
    "tool:test": "node --test tool/*.test.mjs supabase/functions/admin-assign-user-role/*.test.mjs supabase/functions/create-course/*.test.mjs supabase/functions/create-checkout-order/*.test.mjs supabase/functions/_shared/payments/*.test.mjs supabase/functions/initialize-checkout/*.test.mjs supabase/functions/payment-provider-webhook/*.test.mjs supabase/functions/upload-bank-receipt/*.test.mjs supabase/functions/admin-review-bank-transfer/*.test.mjs supabase/functions/admin-entitlements/*.test.mjs supabase/functions/payment-notifications/*.test.mjs supabase/functions/authorize-video/*.test.mjs supabase/functions/_shared/pdf/*.test.mjs supabase/functions/pdf-content/*.test.mjs supabase/functions/admin-dashboard-stats/*.test.mjs supabase/functions/admin-financial-report/*.test.mjs supabase/functions/admin-create-media-upload/*.test.mjs supabase/functions/admin-publish-course/*.test.mjs supabase/functions/admin-enrollments/*.test.mjs supabase/functions/admin-directory/*.test.mjs",
    "payment:sandbox:verify": "node tool/payhere_sandbox_verify.mjs",
    "db:prepare": "node tool/local_supabase.mjs prepare dev",
    "db:start": "node tool/local_supabase.mjs start dev",
    "db:stop": "node tool/local_supabase.mjs stop dev",
    "db:status": "node tool/local_supabase.mjs status dev",
    "db:reset": "node tool/local_supabase.mjs reset dev",
    "db:test": "node tool/financial_db_verify.mjs",
    "db:lint": "node tool/local_supabase.mjs lint test",
    "db:test:stop": "node tool/local_supabase.mjs stop test",
    "client:env": "node tool/local_supabase.mjs client-env dev"
  },
  "devDependencies": { "supabase": "2.120.0" }
}
